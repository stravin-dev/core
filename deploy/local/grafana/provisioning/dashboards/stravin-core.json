      "title": "Overview (System Health & Key KPIs)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Overall server error rate over the selected time range on stravin-edge excluding client_canceled (499) and rate_limited (429). Green < 1%, Yellow 1-5%, Red >= 5%.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 101,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "((sum(increase(stravin_edge_requests_total{status_code!~\"2..|ok\",error_class!~\"client_canceled|rate_limited\"}[$__range])) or vector(0)) / clamp_min(sum(increase(stravin_edge_requests_total[$__range])), 1)) or vector(0)",
          "legendFormat": "server error rate",
          "refId": "A"
        }
      ],
      "title": "System Health (Server Error Rate)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Non-client_canceled server errors over the selected time range across edge, node, S3 pack fetches, aux-index refreshes, and compaction (must remain zero under healthy operation).",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 102,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "round((sum(increase(stravin_edge_requests_total{status_code!~\"2..|ok\",error_class!~\"client_canceled|rate_limited\"}[$__range])) or vector(0)) + (sum(increase(stravin_node_requests_total{status_code=\"error\"}[$__range])) or vector(0)) + (sum(increase(stravin_node_s3_pack_fetches_total{status_code=\"error\"}[$__range])) or vector(0)) + (sum(increase(stravin_node_aux_index_refresh_failures_total[$__range])) or vector(0)) + (sum(increase(stravin_pack_compaction_cycles_total{result=\"error\"}[$__range])) or vector(0)))",
          "legendFormat": "server errors",
          "refId": "A"
        }
      ],
      "title": "Total Server Errors",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Expected client-side cancellations (HTTP 499 / client_canceled) and rate-limit rejections (HTTP 429 / rate_limited) over the selected time range, separated from real server errors.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 103,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "round(sum(increase(stravin_edge_requests_total{error_class=\"client_canceled\"}[$__range])) or vector(0))",
          "legendFormat": "client_canceled (499)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "round(sum(increase(stravin_edge_requests_total{error_class=\"rate_limited\"}[$__range])) or vector(0))",
          "legendFormat": "rate_limited (429)",
          "refId": "B"
        }
      ],
      "title": "Client Canceled (499) & Rate Limited (429)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Compaction cycle, lease renewal, integrity scrub, and recovery errors over the selected time range across stravin-pack and stravin-ctrl.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
