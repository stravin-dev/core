    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "DynamoDB Ref-CAS transaction outcomes (ok, conflict, throttled) and retry rate.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
