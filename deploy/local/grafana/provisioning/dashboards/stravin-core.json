        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(stravin_node_cache_hits_total[5m])) / clamp_min(sum(rate(stravin_node_cache_hits_total[5m])) + sum(rate(stravin_node_cache_misses_total[5m])), 1)",
          "legendFormat": "cache hit ratio",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(stravin_node_cache_bytes_used)",
          "legendFormat": "cache bytes used",
          "refId": "B"
        }
      ],
      "title": "NVMe Cache Hit Ratio & Tenant Bytes (stravin-node)",
      "type": "timeseries"
    },
