    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Warm bare-repo NVMe cache hit ratio and bytes used on stravin-node.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "cache bytes used" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 8,
