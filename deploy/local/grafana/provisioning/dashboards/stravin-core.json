  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Overall Git ingress RPS and error rate across SSH and Smart HTTP (stravin-edge).",
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "targetBlank": true,
              "title": "Explore Tempo Traces (stravin-edge)",
              "url": "/explore?left=%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7Bresource.service.name%3D%5C%22stravin-edge%5C%22%7D%22%7D%5D%7D"
            },
            {
              "targetBlank": true,
              "title": "Explore Loki Logs (stravin-edge)",
              "url": "/explore?left=%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22expr%22%3A%22%7Bservice_name%3D%5C%22stravin-edge%5C%22%7D%22%7D%5D%7D"
            }
          ],
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (git_protocol, git_operation) (rate(stravin_edge_requests_total[5m]))",
          "legendFormat": "{{git_protocol}} {{git_operation}} rps",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (git_protocol, git_operation, error_class) (rate(stravin_edge_requests_total{status_code!~\"2..\"}[5m]))",
          "legendFormat": "err {{git_protocol}} {{git_operation}} ({{error_class}})",
          "refId": "B"
        }
      ],
      "title": "Ingress RPS & Errors (stravin-edge)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Ingress p50/p95/p99 latency with clickable Tempo exemplars (stravin-edge).",
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "targetBlank": true,
              "title": "Explore Slow Traces in Tempo",
              "url": "/explore?left=%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7Bresource.service.name%3D%5C%22stravin-edge%5C%22%20%26%26%20duration%3E100ms%7D%22%7D%5D%7D"
            }
          ],
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "exemplar": true,
          "expr": "histogram_quantile(0.50, sum by (le, git_protocol, git_operation) (rate(stravin_edge_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{git_protocol}} {{git_operation}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "exemplar": true,
          "expr": "histogram_quantile(0.95, sum by (le, git_protocol, git_operation) (rate(stravin_edge_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{git_protocol}} {{git_operation}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "exemplar": true,
          "expr": "histogram_quantile(0.99, sum by (le, git_protocol, git_operation) (rate(stravin_edge_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{git_protocol}} {{git_operation}}",
          "refId": "C"
        }
      ],
      "title": "Ingress Latency p50 / p95 / p99 (stravin-edge)",
      "type": "timeseries"
    },
    {
      "datasource": {
