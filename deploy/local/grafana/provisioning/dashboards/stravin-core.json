      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 104,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "round((sum(increase(stravin_pack_compaction_cycles_total{result=\"error\"}[$__range])) or vector(0)) + (sum(increase(stravin_ctrl_lease_renewals_total{result=\"error\"}[$__range])) or vector(0)) + (sum(increase(stravin_ctrl_scrub_runs_total{result=\"error\"}[$__range])) or vector(0)) + (sum(increase(stravin_ctrl_recovery_runs_total{result=\"error\"}[$__range])) or vector(0)))",
          "legendFormat": "pack + ctrl errors",
          "refId": "A"
        }
      ],
      "title": "Compaction & Control Errors",
      "type": "stat"
    },
    {
